{
  "name": "@helix/shipping-core",
  "version": "0.5.0",
  "private": true,
  "description": "Shipping and dispatch primitives for the Helix fulfilment platform. Provides carriers, services, rates, shipments, labels, manifests, tracking, customs, returns, pickups and webhook delivery on top of an in-memory persistence stack suitable for tests and lightweight deployments.",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "rimraf": "5.0.9",
    "ts-jest": "29.1.5",
    "typescript": "5.5.3"
  }
}
